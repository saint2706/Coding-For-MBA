{
  "name": "coding-for-mba",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://saint2706.github.io/Coding-For-MBA",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.js && node scripts/generate-llms-txt.js && tsc -b && vite build",
    "analyze": "node scripts/generate-sitemap.js && node scripts/generate-llms-txt.js && tsc -b && vite build --mode analyze",
    "analyze:report": "node scripts/analyze-bundle.js",
    "lint": "npm run typecheck",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "validate-content": "node scripts/validate-content.js",
    "predeploy": "npm run build",
    "optimize:images": "node scripts/optimize-images.js",
    "deploy": "gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky",
    "lint:ci": "npm run typecheck"
  },
  "dependencies": {
    "@dr.pogodin/react-helmet": "^3.0.6",
    "canvas-confetti": "^1.9.3",
    "d3": "^7.9.0",
    "fuse.js": "^7.1.0",
    "motion": "^12.34.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.5.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.3.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "beasties": "^0.4.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "sh -c 'npm run typecheck'"
    ],
    "*.{ts,tsx,js,jsx,css,md,json}": [
      "prettier --check"
    ]
  }
}
